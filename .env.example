# Copy this file to .env.local for local development.

# MongoDB Atlas connection string. Transactions need a replica set, which Atlas provides.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/parenthood_art_bank

# Long random secret used to sign login sessions.
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Browser addresses allowed to call the API, separated by commas.
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Folder for encrypted private uploads.
UPLOAD_DIR=private_uploads

# 32 random bytes as base64. Keep this safe: losing it makes uploaded files unreadable.
UPLOAD_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# Password for the first Super Admin, used by npm run seed:superadmin (12 characters or more).
SEED_SUPERADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Virus scanning is optional in development and required in production.
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
